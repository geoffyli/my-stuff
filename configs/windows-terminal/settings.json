{
    // ========================================================================
    //  Windows Terminal settings — mirrors the macOS Ghostty look:
    //  Catppuccin Mocha theme, JetBrainsMono Nerd Font 14, ~0.92 opacity.
    //
    //  Apply: copy to
    //    %LOCALAPPDATA%\Packages\Microsoft.WindowsTerminal_8wekyb3d8bbwe\LocalState\settings.json
    //  (Store install) — see README.md for the exact path & backup step.
    //  Requires JetBrainsMono Nerd Font installed (winget: install the Nerd Font,
    //  or grab it from nerdfonts.com).
    // ========================================================================
    "$help": "https://aka.ms/terminal-documentation",
    "$schema": "https://aka.ms/terminal-profiles-schema",

    "defaultProfile": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",  // PowerShell 7 (pwsh)
    "copyOnSelect": true,
    "copyFormatting": "none",

    "profiles": {
        "defaults": {
            "font": {
                "face": "JetBrainsMono Nerd Font",
                "size": 14
            },
            "colorScheme": "Catppuccin Mocha",
            "opacity": 92,
            "useAcrylic": true,
            "cursorShape": "bar",
            "padding": "8"
        },
        "list": [
            {
                // PowerShell 7 — install via `winget install Microsoft.PowerShell`.
                "guid": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
                "name": "PowerShell",
                "commandline": "pwsh.exe",
                "hidden": false
            },
            {
                // Windows PowerShell 5.1 (built in).
                "guid": "{61c54bbd-c2c6-5271-96e7-009a87ff44bf}",
                "name": "Windows PowerShell",
                "commandline": "powershell.exe",
                "hidden": false
            },
            {
                // Git Bash (matches your VS Code default terminal profile).
                "guid": "{2ece5bfe-50ed-5f3a-ab87-5cd4baafed2b}",
                "name": "Git Bash",
                "hidden": false
            }
        ]
    },

    "schemes": [
        {
            // Catppuccin Mocha — same palette as your Ghostty theme.
            "name": "Catppuccin Mocha",
            "background": "#1E1E2E",
            "foreground": "#CDD6F4",
            "cursorColor": "#F5E0DC",
            "selectionBackground": "#585B70",
            "black": "#45475A",
            "red": "#F38BA8",
            "green": "#A6E3A1",
            "yellow": "#F9E2AF",
            "blue": "#89B4FA",
            "purple": "#F5C2E7",
            "cyan": "#94E2D5",
            "white": "#BAC2DE",
            "brightBlack": "#585B70",
            "brightRed": "#F38BA8",
            "brightGreen": "#A6E3A1",
            "brightYellow": "#F9E2AF",
            "brightBlue": "#89B4FA",
            "brightPurple": "#F5C2E7",
            "brightCyan": "#94E2D5",
            "brightWhite": "#A6ADC8"
        }
    ],

    "actions": [
        { "command": { "action": "copy", "singleLine": false }, "keys": "ctrl+c" },
        { "command": "paste", "keys": "ctrl+v" },
        { "command": "find", "keys": "ctrl+shift+f" },
        { "command": { "action": "splitPane", "split": "auto", "splitMode": "duplicate" }, "keys": "alt+shift+d" }
    ]
}
