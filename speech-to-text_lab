<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <title>轻量级语音转文字</title>
  <style>
    body { font-family: system-ui, sans-serif; padding: 20px; max-width: 700px; margin: auto; }
    #output { width: 100%; height: 300px; margin-top: 15px; padding: 10px; font-size: 16px; }
    button { padding: 10px 20px; font-size: 16px; cursor: pointer; }
  </style>
</head>
<body>
  <h3>实时语音转文字 (Web Speech API)</h3>
  <button id="toggleBtn">开始录音</button>
  <span id="status" style="margin-left:10px; color: gray;">未开始</span>
  <textarea id="output" placeholder="识别结果将显示在这里..."></textarea>

  <script>
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    const recognition = new SpeechRecognition();
    recognition.lang = 'zh-CN';
    recognition.continuous = true;
    recognition.interimResults = true;

    let isRecording = false;
    const btn = document.getElementById('toggleBtn');
    const status = document.getElementById('status');
    const output = document.getElementById('output');
    let finalTranscript = '';

    recognition.onresult = (event) => {
      let interimTranscript = '';
      for (let i = event.resultIndex; i < event.results.length; ++i) {
        if (event.results[i].isFinal) {
          finalTranscript += event.results[i][0].transcript + '。\n';
        } else {
          interimTranscript += event.results[i][0].transcript;
        }
      }
      output.value = finalTranscript + interimTranscript;
    };

    btn.onclick = () => {
      if (!isRecording) {
        recognition.start();
        btn.innerText = '停止录音';
        status.innerText = '正在聆听...';
      } else {
        recognition.stop();
        btn.innerText = '开始录音';
        status.innerText = '已暂停';
      }
      isRecording = !isRecording;
    };
  </script>
</body>
</html>
